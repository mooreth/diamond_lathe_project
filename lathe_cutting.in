# ============================================================================
# Atomistic diamond-turning (lathe) simulation
#   Rigid diamond fixture (rail, sliding tool, two rotating grippers) +
#   Cu workpiece rod clamped between the grippers, cut by the tool.
#
# Geometry source: lathe_diamond_parts.pdb -> diamond_fixture.data
#                  (converted with convert_diamond_fixture.py)
# Metal potential:  CuAlW.txt  (Zhou-style EAM/alloy, only "Cu" block used)
#
# Chain -> molecule-ID map (see convert_diamond_fixture.py output):
#   A=1 E=5           tool holder + cutting tip   (slides along rail, +/-y)
#   B=2 C=3 D=4       rail beam + end mounts       (one-time radial infeed,
#                                                    then held fixed)
#   F=6 G=7 H=8 I=9 J=10   right gripper (fingers, hub, collet nose)
#   K=11 L=12 M=13 N=14 O=15  left gripper (fingers, hub, collet nose)
#
# *** This chain->part mapping was inferred from the geometry (bounding
#     boxes, rotation-axis fit, closest-approach to the workpiece axis).
#     Please confirm it visually before trusting the numbers below -- e.g.
#     load diamond_fixture.data in OVITO and color by "Molecule Identifier".
# ============================================================================

units           metal
dimension       3
boundary        f f f
atom_style      full

read_data       diamond_fixture.data

# ----------------------------------------------------------------------------
# 1. TUNABLE PARAMETERS
# ----------------------------------------------------------------------------
variable dt            equal 0.001     # timestep, ps
variable T0             equal 300.0     # equilibration/bath temperature, K

variable axis_x0        equal -50.0     # spindle (rotation) axis, x
variable axis_z0        equal   6.8     # spindle (rotation) axis, z
variable wp_radius      equal  12.0     # workpiece rod radius, Angstrom

variable y_left_end     equal -105.0    # workpiece rod extent (clamped end, left)
variable y_gap_left     equal  -67.2    # start of free (exposed) span
variable y_gap_right    equal   25.1    # end of free (exposed) span
variable y_right_end    equal   63.0    # workpiece rod extent (clamped end, right)

# closest-approach of the tool tip (chain E) to the spindle axis was measured
# as 21.83 A; workpiece surface is at wp_radius=12 A, so ~9.83 A of travel
# brings the tip to just touch the workpiece. depth_of_cut adds extra plunge.
variable clearance      equal 9.83
variable depth_of_cut   equal 3.0                       # extra plunge, Angstrom
variable ux             equal -0.8851                    # infeed direction (x)
variable uz             equal -0.4654                    # infeed direction (z)
variable infeed_total   equal ${clearance}+${depth_of_cut}
variable dx_infeed      equal ${ux}*${infeed_total}
variable dz_infeed      equal ${uz}*${infeed_total}

variable infeed_time    equal 20.0      # ps, duration of radial infeed move
variable spindle_period equal 150.0     # ps per revolution (~0.5 A/ps surface speed)
variable feed_rate      equal 0.3       # A/ps, tool travel speed along the rail (y)
variable cut_time       equal 250.0     # ps, length of the cutting pass

variable equil_steps    equal round(5.0/${dt})
variable infeed_steps   equal round(${infeed_time}/${dt})
variable cut_steps      equal round(${cut_time}/${dt})

# ----------------------------------------------------------------------------
# 2. ADD THE Cu WORKPIECE (EAM lattice, cylinder along the spindle axis)
# ----------------------------------------------------------------------------
lattice         fcc 3.615
region          wp_cyl cylinder y ${axis_x0} ${axis_z0} ${wp_radius} &
                ${y_left_end} ${y_right_end} units box
create_atoms    3 region wp_cyl

# ----------------------------------------------------------------------------
# 3. GROUPS FOR THE RIGID DIAMOND PARTS
# ----------------------------------------------------------------------------
group           rail                 molecule 2 3 4
group           tool                 molecule 1 5
group           gripper_right_diamond molecule 6 7 8 9 10
group           gripper_left_diamond  molecule 11 12 13 14 15
group           diamond_all          union rail tool gripper_right_diamond gripper_left_diamond
group           workpiece_all        type 3

# ----------------------------------------------------------------------------
# 4. PAIR STYLE:  EAM for the Cu workpiece, purely-repulsive Morse for any
#    diamond<->Cu contact, zero (placeholder) for internal diamond pairs
#    since the diamond fixture is driven kinematically (fix move) and its
#    internal C-C/C-H/H-H forces are never used.
# ----------------------------------------------------------------------------
pair_style      hybrid/overlay eam/alloy morse 6.0
pair_coeff      * * eam/alloy CuAlW.txt NULL NULL Cu

pair_coeff      1 1 morse 0.0 1.0 1.0 0.1     # C-C  (diamond internal, unused)
pair_coeff      1 2 morse 0.0 1.0 1.0 0.1     # C-H  (diamond internal, unused)
pair_coeff      2 2 morse 0.0 1.0 1.0 0.1     # H-H  (diamond internal, unused)
pair_coeff      1 3 morse 0.40 2.20 2.90 6.0  # C -Cu  (tool/fixture <-> metal, repulsive; TUNE ME)
pair_coeff      2 3 morse 0.10 2.00 2.50 6.0  # H -Cu  (tool/fixture <-> metal, repulsive; TUNE ME)

neighbor        2.0 bin
neigh_modify    delay 5 every 1 check yes
newton          on

# skip computing forces within/between rigid diamond groups (they move
# kinematically via fix move and never need their mutual forces)
neigh_modify    exclude group diamond_all diamond_all

# carve a bore through the (originally fully-closed) collet jaws so the new
# Cu rod isn't overlapping diamond atoms
delete_atoms    overlap 2.0 diamond_all workpiece_all

# delete_atoms leaves gaps in the atom-ID numbering (it won't auto-compress
# for a "molecular" atom_style like full) -- renumber consecutively so
# velocity create/dump/etc. don't choke on non-consecutive IDs
reset_atoms     id

# ----------------------------------------------------------------------------
# 5. SUBDIVIDE THE WORKPIECE: clamped ends (co-rotate with the grippers)
#    vs. the free, exposed span where the tool actually cuts
# ----------------------------------------------------------------------------
region          yslab_left  block INF INF ${y_left_end}  ${y_gap_left}  INF INF units box
region          yslab_free  block INF INF ${y_gap_left}  ${y_gap_right} INF INF units box
region          yslab_right block INF INF ${y_gap_right} ${y_right_end} INF INF units box

group           tmp_left  region yslab_left
group           tmp_free  region yslab_free
group           tmp_right region yslab_right

group           workpiece_clamped_left  intersect tmp_left  workpiece_all
group           workpiece_free          intersect tmp_free  workpiece_all
group           workpiece_clamped_right intersect tmp_right workpiece_all

group           spin_left  union gripper_left_diamond  workpiece_clamped_left
group           spin_right union gripper_right_diamond workpiece_clamped_right

# ----------------------------------------------------------------------------
# 6. COMPUTES / OUTPUT
# ----------------------------------------------------------------------------
compute         pe_atom all pe/atom
compute         temp_free workpiece_free temp

thermo          200
thermo_style    custom step temp c_temp_free pe ke etotal press

dump            1 all custom 2000 dump.lathe_cutting.*.lammpstrj &
                id mol type x y z vx vy vz c_pe_atom
dump_modify     1 sort id
# (dump_modify "element" only works for cfg/xyz/image styles, not custom --
#  map type 1=C, 2=H, 3=Cu yourself when visualizing, e.g. in OVITO)

timestep        ${dt}

# ----------------------------------------------------------------------------
# 7. STAGE 1 -- EQUILIBRATION
#    Diamond fixture held rigidly fixed; only the free workpiece span
#    equilibrates to T0. (Clamped ends stay frozen with the grippers so
#    nothing has to "hand off" between fixes later.)
# ----------------------------------------------------------------------------
fix             freeze_rail  rail        setforce 0.0 0.0 0.0
fix             freeze_tool  tool        setforce 0.0 0.0 0.0
fix             freeze_spinL spin_left   setforce 0.0 0.0 0.0
fix             freeze_spinR spin_right  setforce 0.0 0.0 0.0
velocity        rail       set 0.0 0.0 0.0
velocity        tool       set 0.0 0.0 0.0
velocity        spin_left  set 0.0 0.0 0.0
velocity        spin_right set 0.0 0.0 0.0

velocity        workpiece_free create ${T0} 12345 mom yes rot yes dist gaussian
fix             nve_free  workpiece_free nve
fix             therm_free workpiece_free langevin ${T0} ${T0} 0.1 48279

run             ${equil_steps}

# ----------------------------------------------------------------------------
# 8. STAGE 2 -- RADIAL INFEED
#    Whole rail+tool assembly translates rigidly toward the workpiece until
#    the tool tip engages it by 'depth_of_cut'.
# ----------------------------------------------------------------------------
unfix           freeze_rail
unfix           freeze_tool

variable        vx_in equal ${dx_infeed}/${infeed_time}
variable        vz_in equal ${dz_infeed}/${infeed_time}

fix             infeed_rail rail move linear ${vx_in} 0.0 ${vz_in} units box
fix             infeed_tool tool move linear ${vx_in} 0.0 ${vz_in} units box

run             ${infeed_steps}

unfix           infeed_rail
unfix           infeed_tool
velocity        rail set 0.0 0.0 0.0
fix             freeze_rail rail setforce 0.0 0.0 0.0     # rail stays put from here on

# ----------------------------------------------------------------------------
# 9. STAGE 3 -- CUTTING PASS
#    Tool slides along the rail (+y) at the engaged depth; both grippers
#    (with their clamped workpiece ends) spin up about the spindle axis.
#    The free workpiece span deforms/is removed as the tool passes.
# ----------------------------------------------------------------------------
fix             feed_tool tool move linear 0.0 ${feed_rate} 0.0 units box

unfix           freeze_spinL
unfix           freeze_spinR
fix             spin_L spin_left  move rotate ${axis_x0} 0.0 ${axis_z0} 0.0 1.0 0.0 ${spindle_period} units box
fix             spin_R spin_right move rotate ${axis_x0} 0.0 ${axis_z0} 0.0 1.0 0.0 ${spindle_period} units box

run             ${cut_steps}

write_data      final_state.data
